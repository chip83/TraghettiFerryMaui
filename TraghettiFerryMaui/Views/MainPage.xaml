<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:TraghettiFerryMaui.ViewModels"
             xmlns:models="clr-namespace:TraghettiFerryMaui.Models"
             x:Class="TraghettiFerryMaui.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Traghetti Ferry"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Location Card -->
            <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding LocationText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Posizione Manuale"
                               VerticalOptions="Center"
                               FontSize="14" />
                        <Switch IsToggled="{Binding IsManualLocation}"
                                OnColor="{StaticResource Primary}"
                                Toggled="OnManualLocationToggled" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsManualLocation}">
                        <Button Text="LA MADDALENA"
                                Command="{Binding ChangeLocationCommand}"
                                CommandParameter="LA MADDALENA"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"
                                HorizontalOptions="FillAndExpand" />
                        <Button Text="PALAU"
                                Command="{Binding ChangeLocationCommand}"
                                CommandParameter="PALAU"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White"
                                CornerRadius="8"
                                HorizontalOptions="FillAndExpand" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Date Time Card -->
            <Frame BackgroundColor="White" CornerRadius="12" HasShadow="True" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding DateTimeText}"
                           FontSize="16"
                           TextColor="{StaticResource Gray900}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Cambia Data/Ora"
                                Clicked="OnSelectDateTimeClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="8"
                                HorizontalOptions="FillAndExpand" />
                        <Button Text="Ora"
                                Command="{Binding ResetDateTimeCommand}"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White"
                                CornerRadius="8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Ferries Title -->
            <Label Text="Prossimi Traghetti"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" />

            <!-- Ferries List -->
            <CollectionView ItemsSource="{Binding Ferries}"
                           SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ferry">
                        <Frame BackgroundColor="{Binding BackgroundColor}"
                               CornerRadius="8"
                               Margin="0,4"
                               Padding="16"
                               HasShadow="True"
                               Opacity="{Binding Opacity}">
                            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="16">
                                <!-- Departure -->
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="Partenza"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding DepartureTime}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}" />
                                </VerticalStackLayout>

                                <!-- Arrow -->
                                <Label Grid.Column="1"
                                       Text="→"
                                       FontSize="24"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />

                                <!-- Arrival -->
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Arrivo"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding ArrivalTime}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}" />
                                </VerticalStackLayout>

                                <!-- Company Badge -->
                                <Frame Grid.Column="3"
                                       BackgroundColor="{Binding CompanyColor}"
                                       CornerRadius="16"
                                       Padding="12,8"
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding Company}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>